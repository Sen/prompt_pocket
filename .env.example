OPENAI_API_KEY=
# Default selected model in the UI.
OPENAI_MODEL=gpt-5.2
# Optional. Example: http://127.0.0.1:7890
OPENAI_PROXY_URL=
# Optional. If set, the web UI and API require this password.
APP_PASSWORD=
# Optional. API server port. Defaults to 8787.
PORT=8787
# Optional. Local SQLite database path for persisted call logs.
PROMPT_LOG_DB_PATH=data/prompt-pocket.sqlite
# Optional. Max call logs returned by the API. Defaults to 2000.
PROMPT_LOG_LIMIT=2000
